builder$append(
server = "server_1",
url = "dslite.server1",
table = "uprn_asthma_green1",
driver = "DSLiteDriver"
)
builder$append(
server = "server_2",
url = "dslite.server2",
table = "uprn_asthma_green2",
driver = "DSLiteDriver"
)
logindata <- builder$build()
conns <- DSI::datashield.login(logins = logindata, assign = FALSE)
datashield.assign.table(conns, "D", logindata)
