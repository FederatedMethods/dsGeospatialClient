?opal.project_create
opal.project_create(o, "UPRN", database = NULL, title = NULL)
opal.table_save(
o,
satellite_liverpool,
"UPRN",
"satellite_metrics",
overwrite = TRUE,
force = TRUE,
id.name = "UPRN"
)
opal.project_create(o, "UPRN", database = "DataSHIELD", title = NULL)
opal.project_delete(o, "UPRN")
opal.project_create(o, "UPRN", database = "DataSHIELD", title = NULL)
opal.project_create(o, "UPRN", database = "mongodb", title = NULL)
opal.table_save(
o,
satellite_liverpool,
"UPRN",
"satellite_metrics",
overwrite = TRUE,
force = TRUE,
id.name = "UPRN"
)
